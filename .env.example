# Leaderboard storage — Upstash for Redis (connected via the Vercel Marketplace).
#
# PRODUCTION reads these from Vercel's own environment automatically; this file is
# NOT used in prod. It only documents the variables the leaderboard function
# (api/scores.ts) needs for LOCAL development with `vercel dev`.
#
# To run the leaderboard locally:  cp .env.example .env  &&  fill in real values
# (or just run `vercel env pull`, which writes them for you). The real `.env` is
# gitignored — never commit credentials.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Some Upstash Marketplace setups name them instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
